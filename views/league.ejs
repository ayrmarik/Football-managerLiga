<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Лига — Футбольный Менеджер</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen">
  <nav class="bg-slate-800 border-b border-slate-700">
    <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center text-sm">
      <a href="/" class="text-lg font-bold text-green-400">⚽ ФМ</a>
      <div class="flex gap-4 items-center">
        <a href="/dashboard" class="hover:text-green-400">Кабинет</a>
        <a href="/squad" class="hover:text-green-400">Состав</a>
        <a href="/league" class="text-green-400">Лига</a>
        <a href="/transfers" class="hover:text-green-400">Трансферы</a>
        <% if (user.is_admin) { %><a href="/admin" class="text-yellow-400">Админка</a><% } %>
        <span class="text-slate-500"><%= user.username %></span>
        <a href="/logout" class="text-red-400">Выйти</a>
      </div>
    </div>
  </nav>

  <div class="max-w-5xl mx-auto px-4 py-8">
    <% if (!league) { %>
      <p class="text-center text-slate-400 py-20">Лига ещё не создана</p>
    <% } else { %>
      <h1 class="text-2xl font-bold mb-2"><%= league.name %></h1>
      <p class="text-slate-400 mb-6">Сезон <%= league.season %></p>

      <div class="bg-slate-800 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-slate-700 text-slate-300">
            <tr>
              <th class="text-left px-4 py-3">#</th>
              <th class="text-left px-4 py-3">Команда</th>
              <th class="px-4 py-3">И</th>
              <th class="px-4 py-3">В</th>
              <th class="px-4 py-3">Н</th>
              <th class="px-4 py-3">П</th>
              <th class="px-4 py-3">Мячи</th>
              <th class="px-4 py-3">Очки</th>
            </tr>
          </thead>
          <tbody>
            <% table.forEach((row, i) => { %>
              <tr class="border-t border-slate-700 <%= row.username === user.username ? 'bg-green-900/20' : '' %>">
                <td class="px-4 py-2 font-bold text-slate-400"><%= i + 1 %></td>
                <td class="px-4 py-2">
                  <div class="font-medium"><%= row.team_name %></div>
                  <div class="text-xs text-slate-500"><%= row.username %></div>
                </td>
                <td class="px-4 py-2 text-center"><%= row.played %></td>
                <td class="px-4 py-2 text-center text-green-400"><%= row.won %></td>
                <td class="px-4 py-2 text-center"><%= row.drawn %></td>
                <td class="px-4 py-2 text-center text-red-400"><%= row.lost %></td>
                <td class="px-4 py-2 text-center"><%= row.goals_for %>:<%= row.goals_against %></td>
                <td class="px-4 py-2 text-center font-bold text-lg"><%= row.points %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
