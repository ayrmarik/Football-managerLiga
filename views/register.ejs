<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Регистрация — Футбольный Менеджер</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen flex items-center justify-center">
  <div class="bg-slate-800 p-8 rounded-2xl w-full max-w-md shadow-xl">
    <h1 class="text-2xl font-bold text-center mb-6">Регистрация</h1>
    
    <% if (error) { %>
      <div class="bg-red-900/50 border border-red-700 text-red-300 px-4 py-2 rounded mb-4 text-sm"><%= error %></div>
    <% } %>

    <form method="POST" action="/register" class="space-y-4">
      <div>
        <label class="block text-sm text-slate-400 mb-1">Логин</label>
        <input type="text" name="username" required minlength="3" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:border-green-500">
      </div>
      <div>
        <label class="block text-sm text-slate-400 mb-1">Пароль</label>
        <input type="password" name="password" required minlength="4" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:border-green-500">
      </div>
      <div>
        <label class="block text-sm text-slate-400 mb-1">Название команды</label>
        <input type="text" name="teamName" required minlength="2" placeholder="Например: Спартак" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:border-green-500">
      </div>
      <button type="submit" class="w-full bg-green-600 hover:bg-green-500 py-2 rounded-lg font-semibold">Создать клуб</button>
    </form>

    <p class="text-center text-slate-400 text-sm mt-6">
      Уже есть аккаунт? <a href="/login" class="text-green-400 hover:underline">Войти</a>
    </p>
  </div>
</body>
</html>
