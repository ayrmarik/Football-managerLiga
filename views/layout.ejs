<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Футбольный Менеджер</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); min-height: 100vh; }
    .card { background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(10px); }
  </style>
</head>
<body class="text-white">
  <nav class="bg-slate-900/80 border-b border-slate-700 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-green-400">⚽ Футбольный Менеджер</a>
      <div class="flex items-center gap-4 text-sm">
        <% if (user) { %>
          <a href="/dashboard" class="hover:text-green-400">Кабинет</a>
          <a href="/squad" class="hover:text-green-400">Состав</a>
          <a href="/league" class="hover:text-green-400">Лига</a>
          <a href="/transfers" class="hover:text-green-400">Трансферы</a>
          <% if (user.is_admin) { %>
            <a href="/admin" class="text-yellow-400 hover:text-yellow-300">Админка</a>
          <% } %>
          <span class="text-slate-400"><%= user.username %></span>
          <a href="/logout" class="text-red-400 hover:text-red-300">Выйти</a>
        <% } else { %>
          <a href="/login" class="hover:text-green-400">Войти</a>
          <a href="/register" class="bg-green-600 hover:bg-green-500 px-3 py-1 rounded">Регистрация</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <%- body %>
  </main>

  <footer class="text-center text-slate-500 text-sm py-6">
    Футбольный менеджер для друзей · Сделано с помощью Grok
  </footer>
</body>
</html>
